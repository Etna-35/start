# --- Database ---
DATABASE_URL=postgresql+psycopg2://chrono:chrono@db:5432/chrono

# --- MAX Bot API ---
MAX_BOT_TOKEN=put-your-bot-token-here
# Optional shared secret. If set, incoming webhooks must send it (see WEBHOOK_SECRET_HEADER).
MAX_WEBHOOK_SECRET=
# Header name MAX (or your proxy) uses to deliver the secret.
WEBHOOK_SECRET_HEADER=X-Max-Bot-Api-Secret
# Base URL for the MAX Bot API. Adjust if the official host differs.
MAX_API_BASE_URL=https://botapi.max.ru

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow
# Путь к картинке-памятке A/B/C/D (если файла нет — подсказка просто отключена).
LEGEND_IMAGE_PATH=assets/legend.png

# --- Daily review schedule (in each user's local timezone) ---
DAILY_REVIEW_HOUR=22
DAILY_REVIEW_MINUTE=30
# Set to false to disable the background scheduler (e.g. in tests).
SCHEDULER_ENABLED=true

# --- Admins ---
# Comma-separated MAX user ids that get the admin role automatically.
ADMIN_MAX_USER_IDS=

# --- Production: Caddy auto-HTTPS (used by docker-compose.prod.yml) ---
# Subdomain pointing (A-record) at this VPS. Caddy issues a TLS cert for it.
BOT_DOMAIN=chronobot.no-money-no-honey.ru
# Email for Let's Encrypt notifications.
ACME_EMAIL=you@example.com
# Postgres password for the production DB (change from the default!).
POSTGRES_PASSWORD=change-me-strong-password
